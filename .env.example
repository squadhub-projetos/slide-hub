# ============================================================
# Slide Hub — variáveis de ambiente (apenas placeholders!)
# Nunca commite chaves reais. Nenhuma variável secreta pode ter
# prefixo VITE_ — tudo abaixo de "SERVIDOR" fica só nas funções /api.
# ============================================================

# ------------------------------------------------------------
# SERVIDOR — Providers
# ------------------------------------------------------------
OPENAI_API_KEY=
# Nome principal: ANTHROPIC_API_KEY (CLAUDE_API_KEY aceita como fallback)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# SERVIDOR — Defaults
# ------------------------------------------------------------
# auto | openai | anthropic
AI_DEFAULT_TEXT_PROVIDER=openai
# fast | balanced | quality | custom (fast = raciocínio baixo, saída enxuta)
AI_EXECUTION_MODE=fast

# ------------------------------------------------------------
# SERVIDOR — Modelos POR ETAPA (IDs separados por vírgula,
# definidos AQUI, nunca no código). Etapa sem lista herda do planner.
# ------------------------------------------------------------
AI_OPENAI_CHAT_MODELS=gpt-5.4-mini
AI_OPENAI_PLANNER_MODELS=gpt-5.4-mini,gpt-5.5,gpt-5.6
AI_OPENAI_SLIDE_MODELS=gpt-5.4-mini,gpt-5.4-nano,gpt-5.5
AI_OPENAI_REVISION_MODELS=gpt-5.4-mini,gpt-5.5
AI_DEFAULT_OPENAI_CHAT_MODEL=gpt-5.4-mini
AI_DEFAULT_OPENAI_PLANNER_MODEL=gpt-5.4-mini
AI_DEFAULT_OPENAI_SLIDE_MODEL=gpt-5.4-mini
AI_DEFAULT_OPENAI_REVISION_MODEL=gpt-5.4-mini

AI_ANTHROPIC_CHAT_MODELS=claude-haiku-4-5-20251001
AI_ANTHROPIC_PLANNER_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5
AI_ANTHROPIC_SLIDE_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5
AI_ANTHROPIC_REVISION_MODELS=claude-haiku-4-5-20251001
AI_DEFAULT_ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
AI_DEFAULT_ANTHROPIC_PLANNER_MODEL=claude-haiku-4-5-20251001
AI_DEFAULT_ANTHROPIC_SLIDE_MODEL=claude-haiku-4-5-20251001
AI_DEFAULT_ANTHROPIC_REVISION_MODEL=claude-haiku-4-5-20251001

# Compatibilidade (default quando as listas acima não existem)
OPENAI_TEXT_MODEL=gpt-5.6

# ------------------------------------------------------------
# SERVIDOR — Imagens
# ------------------------------------------------------------
AI_IMAGE_PROVIDER=openai
AI_IMAGE_MODELS=gpt-image-2
AI_DEFAULT_IMAGE_MODEL=gpt-image-2
AI_GENERATE_IMAGES_ONLY_WHEN_NEEDED=true
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=2048x1152
OPENAI_ENABLE_WEB_SEARCH=true

# ------------------------------------------------------------
# SERVIDOR — Performance (timeout POR ETAPA — nunca 150s sem feedback)
# ------------------------------------------------------------
AI_CHAT_TIMEOUT_MS=20000
AI_PLANNER_TIMEOUT_MS=45000
AI_SLIDE_TIMEOUT_MS=40000
AI_REVISION_TIMEOUT_MS=40000
AI_IMAGE_TIMEOUT_MS=120000
AI_UPLOAD_TIMEOUT_MS=30000

AI_MAX_RETRIES=1
AI_SLIDE_CONCURRENCY=3
AI_IMAGE_CONCURRENCY=1

# ------------------------------------------------------------
# SERVIDOR — Features
# ------------------------------------------------------------
AI_PARALLEL_SLIDE_PRODUCTION=true
AI_PROVIDER_FALLBACK_ENABLED=false
AI_DIAGNOSTICS_ENABLED=true
AI_BENCHMARK_ENABLED=true

# ------------------------------------------------------------
# SERVIDOR — Supabase (SECRET_KEY jamais no navegador)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=slide_hub_records
SUPABASE_BUCKET=slide-hub-assets
SLIDE_HUB_WORKSPACE_KEY=squadhub

# ------------------------------------------------------------
# FRONTEND (apenas flags públicas, nunca segredos)
# ------------------------------------------------------------
# false -> IA real (endpoints internos /api; erros reais aparecem como erros)
# true  -> Modo simulação (rotulado na interface; sem custo)
VITE_USE_MOCK_AI=false
