{
  /* Typecheck local das funções /api (tsc -b) — estende o tsconfig REAL
     usado pela Vercel (api/tsconfig.json) para as opções nunca divergirem. */
  "extends": "./api/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["api"]
}
